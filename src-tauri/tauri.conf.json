{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "考研倒计时闭环记录器",
  "version": "0.1.0",
  "identifier": "com.local.kaoyan-loop-recorder",
  "build": {
    "frontendDist": "../"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "考研倒计时闭环记录器",
        "width": 1180,
        "height": 820,
        "minWidth": 390,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  }
}
